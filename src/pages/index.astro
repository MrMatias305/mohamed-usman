---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection(
  'articles',
  ({ data }) => data.draft !== true
);

const latestArticles = articles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Mohamed Usman | Personal Publication"
  description="Thoughts, reflections and lessons about life by Mohamed Usman."
>
  <section class="introduction">
    <p class="eyebrow">PERSONAL PUBLICATION</p>

    <h1>Ideas, reflections &amp; lessons from life.</h1>

    <p>
      A personal space where I explore ideas, reflect on experiences,
      and share lessons gathered along the way.
    </p>

    <a href="/articles/">Explore all articles →</a>
  </section>

  <section class="latest">
    <div class="section-heading">
      <h2>Latest writing</h2>
      <a href="/articles/">View all →</a>
    </div>

    {
      latestArticles.length > 0 ? (
        <div class="article-list">
          {latestArticles.map((article) => (
            <article class="article-item">
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('en', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>

              <h3>
                <a href={`/articles/${article.id}/`}>
                  {article.data.title}
                </a>
              </h3>

              <p>{article.data.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <p>New writing will appear here soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .introduction {
    padding: 3rem 0 5rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-weight: 600;
    opacity: 0.6;
  }

  .introduction h1 {
    max-width: 650px;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .introduction > p:not(.eyebrow) {
    max-width: 540px;
    font-size: 1.1rem;
    opacity: 0.75;
    margin-bottom: 2rem;
  }

  .latest {
    padding: 2rem 0;
    border-top: 1px solid #ddd;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .section-heading a {
    font-size: 0.9rem;
  }

  .article-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid #ddd;
  }

  .article-item time {
    font-size: 0.85rem;
    opacity: 0.6;
  }

  .article-item h3 {
    margin-bottom: 0.4rem;
  }

  .article-item p {
    margin-top: 0;
    opacity: 0.75;
  }
</style>