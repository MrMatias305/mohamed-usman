---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection(
  'articles',
  ({ data }) => data.draft !== true
);

const latestArticles = articles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Mohamed Usman — Thoughts, Reflections & Ideas"
  description="A personal publication exploring ideas, experiences, and lessons gathered along the way."
>
  <section class="hero">
    <p class="eyebrow">
      <span></span>
      AN INDEPENDENT PUBLICATION
    </p>

    <h1>
      Ideas, reflections<br />
      &amp; lessons <em>from life.</em>
    </h1>

    <div class="hero-bottom">
      <p>
        A personal space to explore ideas, reflect on experiences,
        and share the lessons gathered along the way.
      </p>

      <a href="/articles/" class="explore-link">
        Explore the writing
        <span>↗</span>
      </a>
    </div>
  </section>

  <section class="latest">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE JOURNAL</p>
        <h2>Latest writing</h2>
      </div>

      <a href="/articles/" class="view-all">
        All articles <span>→</span>
      </a>
    </div>

    {
      latestArticles.length > 0 ? (
        <div class="article-list">
          {latestArticles.map((article, index) => (
            <article class="article-item">
              <span class="article-number">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div class="article-content">
                <time datetime={article.data.pubDate.toISOString()}>
                  {article.data.pubDate.toLocaleDateString('en', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>

                <h3>
                  <a href={`/articles/${article.id}/`}>
                    {article.data.title}
                  </a>
                </h3>

                <p>{article.data.description}</p>
              </div>

              <a
                href={`/articles/${article.id}/`}
                class="article-arrow"
                aria-label={`Read ${article.data.title}`}
              >
                ↗
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">
          The first article is on its way. New writing will appear here soon.
        </p>
      )
    }
  </section>

  <section class="closing">
    <p>Thank you for being here.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 7rem 0 8rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero h1 {
    max-width: 900px;
    margin: 2rem 0;
    font-size: clamp(3.2rem, 8vw, 6.5rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .hero h1 em {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-bottom {
    max-width: 720px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .hero-bottom p {
    max-width: 390px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.9;
  }

  .explore-link,
  .view-all {
    flex-shrink: 0;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .explore-link span,
  .view-all span {
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 180ms ease;
  }

  .explore-link:hover span,
  .view-all:hover span {
    transform: translate(3px, -3px);
  }

  .latest {
    padding: 3.5rem 0;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-heading .eyebrow {
    margin: 0;
  }

  .section-heading h2 {
    margin: 0.5rem 0 0;
    font-size: 2.5rem;
  }

  .view-all {
    margin-bottom: 0.7rem;
    color: var(--muted);
  }

  .article-item {
    display: grid;
    grid-template-columns: 45px 1fr 30px;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .article-number {
    align-self: start;
    padding-top: 0.2rem;
    color: #aaa49b;
    font-family: var(--font-heading);
    font-size: 1.1rem;
  }

  .article-content time {
    display: block;
    margin-bottom: 0.5rem;
  }

  .article-content h3 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }

  .article-content h3 a {
    text-decoration: none;
    transition: color 180ms ease;
  }

  .article-content h3 a:hover {
    color: var(--accent);
  }

  .article-content p {
    max-width: 600px;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .article-arrow {
    color: var(--muted);
    font-size: 1.2rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .article-arrow:hover {
    color: var(--text);
    transform: translate(3px, -3px);
  }

  .empty-state {
    padding: 2rem 0;
    color: var(--muted);
  }

  .closing {
    padding: 2rem 0 4rem;
    text-align: center;
  }

  .closing p {
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 5rem 0 5.5rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 12vw, 4.5rem);
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }

    .section-heading h2 {
      font-size: 2rem;
    }

    .article-item {
      grid-template-columns: 25px 1fr 20px;
      gap: 0.8rem;
      padding: 1.6rem 0;
    }

    .article-content h3 {
      font-size: 1.35rem;
    }

    .article-content p {
      font-size: 0.85rem;
    }
  }
</style>