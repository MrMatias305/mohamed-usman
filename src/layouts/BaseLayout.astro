---
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />

    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mohamed Usman"
      href="/rss.xml"
    />
  </head>

  <body>
    <div class="page-container">
      <header>
        <a href="/" class="site-name">Mohamed Usman<span>.</span></a>

        <nav aria-label="Main navigation">
          <a href="/articles/">Articles</a>
          <a href="/about/">About</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

     <footer>
      <div class="page-container">
        <div class="footer-brand">
          <a href="/" class="footer-name">Mohamed Usman<span>.</span></a>
          <p>A collection of thoughts,<br />written along the way.</p>
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/articles/">Articles ↗</a>
          <a href="/about/">About ↗</a>
          <a href="/rss.xml">RSS Feed ↗</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Mohamed Usman</p>
        <p>Made with intention <span>✳</span></p>
      </div>
    </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --background: #faf9fc;
    --surface: #ffffff;
    --text: #252525;
    --muted: #77736d;
    --border: #e8e4ef;
    --accent: #9b8abf;

    --font-heading: "Playfair Display", Georgia, serif;
    --font-body: "DM Sans", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
  }

  .page-container {
    width: min(100% - 64px, 1080px);
    margin: 0 auto;
  }

  header {
    min-height: 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .site-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--text);
  }

  .site-name span {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  nav a:hover {
    color: var(--text);
  }

  a {
    color: inherit;
    text-underline-offset: 5px;
  }

  main {
    min-height: 65vh;
    padding: 2rem 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.45rem;
  }

  p {
    margin: 1.2rem 0;
  }

  time {
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.035em;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  footer {
    background: #f2eff8;
    padding: 3.5rem 0 1.5rem;
    border-top: 1px solid #e8e4ef;
  }

.footer-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
  padding-bottom: 3rem;
}

.footer-name {
  font-family: var(--font-heading);
  font-size: 1.7rem;
  color: var(--text);
  text-decoration: none;
}

.footer-name span {
  color: var(--accent);
}

.footer-brand > p {
  margin-top: 0.8rem;
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.8;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.footer-nav a {
  color: var(--muted);
  font-size: 0.85rem;
  text-decoration: none;
  transition: color 180ms ease;
}

.footer-nav a:hover {
  color: var(--accent);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--border);
}

.footer-bottom p {
  margin: 0;
  color: var(--muted);
  font-size: 0.75rem;
}

.footer-bottom span {
  color: var(--accent);
}

@media (max-width: 600px) {
  .footer-main {
    flex-direction: column;
    gap: 2rem;
  }

  .footer-nav {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .footer-bottom {
    flex-direction: column;
    gap: 0.6rem;
  }
}

  ::selection {
    background: #ded8ce;
    color: var(--text);
  }

  @media (max-width: 600px) {
    .page-container {
      width: min(100% - 40px, 1080px);
    }

    header {
      min-height: 85px;
    }

    .site-name {
      font-size: 1.2rem;
    }

    nav {
      gap: 1.2rem;
    }

    nav a {
      font-size: 0.8rem;
    }

    main {
      padding: 1rem 0;
    }

    footer {
      margin-top: 3rem;
    }
  }
</style>